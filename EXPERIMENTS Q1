# Register Transfer and ALU Operations

R1 = int(input("Enter value of R1: "))
R2 = int(input("Enter value of R2: "))

print("\nInitial Registers:")
print("R1 =", R1)
print("R2 =", R2)

print("\nALU Operations:")
print("1. Addition")
print("2. Subtraction")
print("3. AND")
print("4. OR")

choice = int(input("Enter choice: "))

if choice == 1:
    R3 = R1 + R2
    print("\nOperation: R3 <- R1 + R2")

elif choice == 2:
    R3 = R1 - R2
    print("\nOperation: R3 <- R1 - R2")

elif choice == 3:
    R3 = R1 & R2
    print("\nOperation: R3 <- R1 AND R2")

elif choice == 4:
    R3 = R1 | R2
    print("\nOperation: R3 <- R1 OR R2")

else:
    print("Invalid choice")
    exit()

print("R3 =", R3)
